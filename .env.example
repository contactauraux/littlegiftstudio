# Little Gift Studio - Environment Variables Example
# Copy this file to .env and configure your admin credentials

# Developer / Super Admin Credentials
VITE_ADMIN_EMAIL=admin@littlegiftstudio.com
VITE_ADMIN_PASSWORD=your_admin_password_here
VITE_ADMIN_NAME=Dev Admin
VITE_ADMIN_ROLE=Developer / Super Admin

# Store Owner / Client Credentials
VITE_CLIENT_EMAIL=client@littlegiftstudio.com
VITE_CLIENT_PASSWORD=your_client_password_here
VITE_CLIENT_NAME=Little Gift Studio Owner
VITE_CLIENT_ROLE=Store Owner

# Cloudinary Direct Upload Settings (Unsigned Upload Preset)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset_here