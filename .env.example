# Cloudinary Environment Configuration Example
# 1. Sign up at https://cloudinary.com
# 2. Get your Cloud Name from your Dashboard
# 3. Create an Unsigned Upload Preset under Settings -> Upload -> Upload presets
# 4. Copy this file to .env and fill in the values below

VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
